// Datamodell for Ukeplan. Tider lagres i UTC og vises i Europe/Oslo.
// Kategorier og kilder er enums, så skjemaet fungerer likt på SQLite og PostgreSQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Category {
  RELIGION
  SCHOOL
  SOCIAL
  ALONE
  OTHER
}

enum Source {
  MANUAL // lagt inn av deg
  PRAYER // beregnet bønnetid (steg 2)
  AI // planlagt av modellen (steg 3)
}

enum Location {
  HOME
  OUT
}

model Event {
  id        String    @id @default(cuid())
  title     String
  category  Category
  start     DateTime
  end       DateTime
  // Låste blokker flyttes aldri av planleggeren.
  locked    Boolean   @default(false)
  source    Source    @default(MANUAL)
  location  Location?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([start])
}

// Innstillinger som JSON per nøkkel (f.eks. "prayer"), validert med zod i koden.
// Nye felt får standardverdier uten at databasen må migreres.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum Prayer {
  FAJR
  DHUHR
  ASR
  MAGHRIB
  ISHA
}

// Manuell bønnetid for én dato. Går foran beregningen.
model PrayerOverride {
  id     String @id @default(cuid())
  date   String // YYYY-MM-DD i innstillingenes tidssone
  prayer Prayer
  time   String // HH:mm

  @@unique([date, prayer])
}
